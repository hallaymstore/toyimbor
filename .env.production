# Production Environment Configuration
PORT=3000

# JWT Configuration - Generate a strong random secret
JWT_SECRET=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_IN_PRODUCTION

# MongoDB Configuration - Use your production database
MONGODB_URI=mongodb+srv://prod_user:prod_password@prod_cluster.mongodb.net/toyimbor_prod

# Admin Configuration
ADMIN_EMAIL=admin@toyimbor.uz
ADMIN_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD
ADMIN_CARD=CHANGE_THIS_TO_ACTUAL_CARD

# Premium Subscription Configuration
PREMIUM_DAYS=365

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_production_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_production_cloudinary_api_key
CLOUDINARY_API_SECRET=your_production_cloudinary_api_secret

# Node Environment
NODE_ENV=production

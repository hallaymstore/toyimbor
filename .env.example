# Server Configuration
PORT=3000

# JWT Configuration
# Generate a strong secret key for JWT token signing
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# MongoDB Configuration
# Get your connection string from MongoDB Atlas (https://www.mongodb.com/cloud/atlas)
# Format: mongodb+srv://username:password@cluster.mongodb.net/database_name
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/toyimbor

# Admin Configuration
ADMIN_EMAIL=admin@toyimbor.uz
ADMIN_PASSWORD=Admin123!
ADMIN_CARD=9860010110102020

# Premium Subscription Configuration (in days)
PREMIUM_DAYS=365

# Cloudinary Configuration (Optional - for image uploads)
# Get these credentials from Cloudinary Dashboard (https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Node Environment
NODE_ENV=development
